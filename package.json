{
  "name": "rcube-html-examples",
  "version": "0.1.0",
  "private": true,
  "description": "Tutorials and copy-ready examples for rcube-html — forms, tables, charts, calendar, file upload, trees and more — in React, Angular, Vue, plain HTML and JSP.",
  "keywords": [
    "rcube-html",
    "examples",
    "tutorials",
    "sample-application",
    "simple-application",
    "starter",
    "dynamic-forms",
    "dynamic-content",
    "json-forms",
    "form-builder",
    "react",
    "nextjs",
    "angular",
    "vue",
    "jsp",
    "web-component",
    "data-table",
    "charts",
    "calendar",
    "tree-view",
    "file-upload",
    "rich-text-editor",
    "validation",
    "i18n"
  ],
  "author": "Riyaz Hameed <riyaz.mohamed@gmail.com>",
  "scripts": {
    "starter": "node scripts/build-starter.mjs",
    "starters": "node scripts/build-starter.mjs && node scripts/build-starters.mjs",
    "schemas": "node scripts/build-schemas.mjs",
    "check:frameworks": "node scripts/check-frameworks.mjs",
    "predev": "node scripts/build-starter.mjs && node scripts/build-starters.mjs && node scripts/build-schemas.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-starter.mjs && node scripts/build-starters.mjs && node scripts/build-schemas.mjs",
    "build": "next build",
    "preview": "next build && firebase emulators:start --only hosting",
    "deploy": "next build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
