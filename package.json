    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@next/third-parties": "^16.4.3",
    "bootstrap": "5.3.3",
    "next": "16.4.3",
    "rcube-html": "^0.7.0",
    "react": "19.3.1",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": "20.x || 22.x"
