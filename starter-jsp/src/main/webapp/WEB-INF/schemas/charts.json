[
  {
    "type": "row",
    "id": "row-controls",
    "children": [
      {
        "type": "column",
        "id": "c-type",
        "props": {
          "className": "rc-col-12 rc-col-md-4"
        },
        "children": [
          {
            "type": "SelectField",
            "id": "type",
            "props": {
              "name": "chartType",
              "label": "Chart type",
              "defaultValue": "bar",
              "onChange": "typeChanged()",
              "options": [
                {
                  "label": "Bar",
                  "value": "bar"
                },
                {
                  "label": "Line",
                  "value": "line"
                },
                {
                  "label": "Area",
                  "value": "area"
                },
                {
                  "label": "Pie",
                  "value": "pie"
                },
                {
                  "label": "Donut",
                  "value": "donut"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "column",
        "id": "c-slider",
        "props": {
          "className": "rc-col-12 rc-col-md-4"
        },
        "children": [
          {
            "type": "SliderField",
            "id": "march",
            "props": {
              "name": "march",
              "label": "March online sales",
              "min": 0,
              "max": 100,
              "defaultValue": 38,
              "valueSuffix": "K",
              "onChange": "marchChanged()"
            }
          }
        ]
      },
      {
        "type": "column",
        "id": "c-switches",
        "props": {
          "className": "rc-col-12 rc-col-md-4 rc-d-flex rc-gap-3 rc-align-items-center"
        },
        "children": [
          {
            "type": "InputField",
            "id": "stacked",
            "props": {
              "type": "checkbox",
              "name": "stacked",
              "label": "Stacked",
              "onChange": "stackedChanged()"
            }
          },
          {
            "type": "InputField",
            "id": "labels",
            "props": {
              "type": "checkbox",
              "name": "labels",
              "label": "Values",
              "onChange": "labelsChanged()"
            }
          }
        ]
      }
    ]
  },
  {
    "type": "row",
    "id": "row-buttons",
    "children": [
      {
        "type": "column",
        "id": "c-buttons",
        "props": {
          "className": "rc-d-flex rc-flex-wrap rc-gap-2 rc-mb-3"
        },
        "children": [
          {
            "type": "ButtonField",
            "id": "random",
            "props": {
              "text": "Randomize",
              "onClick": "randomize()"
            }
          },
          {
            "type": "ButtonField",
            "id": "add",
            "props": {
              "text": "+ Add month",
              "onClick": "addMonth()"
            }
          },
          {
            "type": "ButtonField",
            "id": "best",
            "props": {
              "text": "Highlight best month",
              "variant": "outline-success",
              "onClick": "highlightBest()"
            }
          },
          {
            "type": "ButtonField",
            "id": "store",
            "props": {
              "text": "Show / hide Store",
              "variant": "outline-secondary",
              "onClick": "toggleStore()"
            }
          }
        ]
      }
    ]
  },
  {
    "type": "Chart",
    "id": "sales",
    "props": {
      "chartType": "bar",
      "title": "Monthly sales",
      "subtitle": "Thousands of USD",
      "height": 300,
      "labels": [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun"
      ],
      "series": [
        {
          "key": "online",
          "name": "Online",
          "data": [
            42,
            51,
            38,
            64,
            58,
            71
          ]
        },
        {
          "key": "store",
          "name": "Store",
          "data": [
            30,
            28,
            35,
            31,
            40,
            37
          ]
        },
        {
          "key": "target",
          "name": "Target",
          "type": "line",
          "dashed": true,
          "data": [
            45,
            48,
            50,
            55,
            60,
            65
          ]
        }
      ],
      "format": "number",
      "yAxis": {
        "title": "Sales (K)"
      },
      "rulers": [
        {
          "value": 60,
          "label": "Goal",
          "showValue": true
        }
      ],
      "pointRules": [
        {
          "when": {
            "lt": 32
          },
          "color": "#d03b3b"
        }
      ],
      "highlightColor": "#0ca30c",
      "tableToggle": true,
      "onPointClick": "pointClicked()",
      "onLegendClick": "legendClicked()"
    }
  }
]
