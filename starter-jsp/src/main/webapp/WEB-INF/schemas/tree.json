[
  {
    "type": "row",
    "id": "row-controls",
    "children": [
      {
        "type": "column",
        "id": "c-name",
        "props": {
          "className": "rc-col-12 rc-col-md-4"
        },
        "children": [
          {
            "type": "InputField",
            "id": "item-name",
            "props": {
              "name": "itemName",
              "label": "Item name",
              "placeholder": "Header.js — end with / for a folder"
            }
          }
        ]
      },
      {
        "type": "column",
        "id": "c-find",
        "props": {
          "className": "rc-col-12 rc-col-md-4"
        },
        "children": [
          {
            "type": "InputField",
            "id": "find",
            "props": {
              "name": "find",
              "label": "Find",
              "placeholder": "type to filter",
              "onChange": "findChanged()"
            }
          }
        ]
      },
      {
        "type": "column",
        "id": "c-view",
        "props": {
          "className": "rc-col-12 rc-col-md-4"
        },
        "children": [
          {
            "type": "SelectField",
            "id": "view",
            "props": {
              "name": "view",
              "label": "View",
              "defaultValue": "tree",
              "onChange": "viewChanged()",
              "options": [
                {
                  "label": "Tree",
                  "value": "tree"
                },
                {
                  "label": "Columns",
                  "value": "columns"
                },
                {
                  "label": "Explorer",
                  "value": "explorer"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  {
    "type": "row",
    "id": "row-buttons",
    "children": [
      {
        "type": "column",
        "id": "c-buttons",
        "props": {
          "className": "rc-d-flex rc-flex-wrap rc-gap-2 rc-mb-2"
        },
        "children": [
          {
            "type": "ButtonField",
            "id": "add",
            "props": {
              "text": "+ Add to selected folder",
              "variant": "outline-success",
              "onClick": "addItem()"
            }
          },
          {
            "type": "ButtonField",
            "id": "rename",
            "props": {
              "text": "Rename selected",
              "variant": "outline-primary",
              "onClick": "renameSelected()"
            }
          },
          {
            "type": "ButtonField",
            "id": "delete",
            "props": {
              "text": "Delete selected",
              "variant": "outline-danger",
              "onClick": "deleteSelected()"
            }
          },
          {
            "type": "ButtonField",
            "id": "goto",
            "props": {
              "text": "Go to dates.js",
              "variant": "outline-secondary",
              "onClick": "goToDates()"
            }
          },
          {
            "type": "ButtonField",
            "id": "checked",
            "props": {
              "text": "Show checked",
              "variant": "outline-secondary",
              "onClick": "showChecked()"
            }
          }
        ]
      }
    ]
  },
  {
    "type": "Tree",
    "id": "project",
    "props": {
      "title": "my-app",
      "nodes": [
        {
          "id": "src",
          "label": "src",
          "expanded": true,
          "children": [
            {
              "id": "src/components",
              "label": "components",
              "expanded": true,
              "children": [
                {
                  "id": "src/components/Button.js",
                  "label": "Button.js",
                  "size": 2310
                },
                {
                  "id": "src/components/Card.js",
                  "label": "Card.js",
                  "size": 1874
                },
                {
                  "id": "src/components/Modal.js",
                  "label": "Modal.js",
                  "size": 4120,
                  "badge": "new"
                }
              ]
            },
            {
              "id": "src/utils",
              "label": "utils",
              "children": [
                {
                  "id": "src/utils/format.js",
                  "label": "format.js",
                  "size": 980
                },
                {
                  "id": "src/utils/dates.js",
                  "label": "dates.js",
                  "size": 1430
                }
              ]
            },
            {
              "id": "src/index.js",
              "label": "index.js",
              "size": 640
            }
          ]
        },
        {
          "id": "public",
          "label": "public",
          "children": [
            {
              "id": "public/index.html",
              "label": "index.html",
              "size": 1210
            },
            {
              "id": "public/logo.png",
              "label": "logo.png",
              "size": 15086
            }
          ]
        },
        {
          "id": "config",
          "label": "config",
          "icon": "⚙️",
          "children": [
            {
              "id": "config/prod.json",
              "label": "prod.json",
              "size": 310,
              "disabled": true,
              "description": "read-only"
            }
          ]
        },
        {
          "id": "package.json",
          "label": "package.json",
          "size": 1532
        },
        {
          "id": "README.md",
          "label": "README.md",
          "size": 4890
        }
      ],
      "height": 330,
      "checkboxes": true,
      "cascadeCheck": true,
      "showLines": true,
      "showCount": true,
      "draggable": true,
      "editable": true,
      "searchable": false,
      "filters": [
        {
          "id": "js",
          "label": ".js only",
          "when": {
            "field": "ext",
            "equals": "js"
          }
        }
      ],
      "contextMenu": [
        {
          "text": "Rename",
          "command": "rename"
        },
        {
          "text": "New file here",
          "onClick": "newFileHere()",
          "when": {
            "field": "branch",
            "equals": true
          }
        },
        {
          "divider": true
        },
        {
          "text": "Delete",
          "onClick": "deleteNode()"
        }
      ],
      "toolbarActions": [
        {
          "text": "Delete selected",
          "variant": "outline-danger",
          "onClick": "deleteSelected()",
          "needsSelection": true
        }
      ],
      "onSelect": "selected()",
      "onExpand": "toggled()",
      "onCollapse": "toggled()",
      "onCheck": "checked()",
      "onActivate": "opened()",
      "onMove": "moved()",
      "onRename": "renamed()",
      "onNodeFocus": "focused()"
    }
  },
  {
    "type": "P",
    "id": "status",
    "props": {
      "className": "rc-small rc-text-body-secondary rc-mt-2",
      "text": "Select, check, drag, double-click or right-click a node."
    }
  }
]
